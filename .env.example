# Azure App Registration (application permissions: Mail.Read, admin consent)
# Never commit real .env

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Mailbox to read (user or shared mailbox in the same tenant)
MAILBOX_UPN=recruitment.application@metaforgeit.com

# SQLite: legacy dump dedupe + pipeline finalization (synced/skipped)
PROCESSED_DB=data/processed_messages.db

# OpenAI (classification + structured extraction)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MIN_CONFIDENCE=0
# Optional Gemini (OpenAI-compatible endpoint adapter)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-1.5-flash

# MetaForge: api = POST JSON, sqlite = local DB file
METAFORGE_MODE=api
METAFORGE_API_URL=https://api.example.com/v1
# Default robust backend ingestion endpoint for auto-email creation
METAFORGE_REQUIREMENTS_ENDPOINT=api/internal/requirements/ingest-email
# Use the same secret as backend INTERNAL_AUTOMATION_API_KEY
METAFORGE_API_KEY=

# Used when METAFORGE_MODE=sqlite (also stores REQ id sequences when mode=api uses METAFORGE_ID_DB)
METAFORGE_SQLITE_PATH=data/metaforge_requirements.db
METAFORGE_ID_DB=data/metaforge_sequences.db

# Logging
LOG_LEVEL=INFO

# MetaForge mapped default (instead of recipient list for Internal POC)
INTERNAL_POC_DEFAULT=offshore demands

# Scheduler mode (python main.py scheduler)
# Poll interval for inbox enqueue cycles (minimum 15 seconds)
SCHEDULER_POLL_SECONDS=120
# Backoff when one cycle errors
SCHEDULER_ERROR_BACKOFF_SECONDS=30
# Heartbeat file for monitoring
SCHEDULER_HEARTBEAT_PATH=data/scheduler_heartbeat.json
# Health checker threshold (seconds). If heartbeat is older than this, alert/fail.
HEARTBEAT_MAX_AGE_SECONDS=300

# Optional file listener (drop .txt/.json raw requirement mails)
FILE_LISTENER_ENABLED=true
FILE_LISTENER_INBOX_DIR=data/mail-drop/inbox
FILE_LISTENER_ARCHIVE_DIR=data/mail-drop/archive

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_CLASSIFIER_RATE_LIMIT=120/m
CELERY_HEAVY_RATE_LIMIT=50/m
CELERY_SYNC_RATE_LIMIT=120/m
